{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tensorappfactory.dev/schemas/android-content-package.schema.json",
  "title": "Tensor Android Versioned Content Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "title", "language", "questions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "package_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "language": {"type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$"},
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "prompt", "answer", "explanation"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"},
          "type": {"enum": ["single_choice", "true_false_not_given", "short_answer"]},
          "prompt": {"type": "string", "minLength": 1},
          "options": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "answer": {"type": "string", "minLength": 1},
          "accepted_answers": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "required_answer_groups": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          },
          "max_answer_words": {"type": "integer", "minimum": 1, "maximum": 100},
          "explanation": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"type": {"const": "single_choice"}}},
            "then": {"required": ["options"]}
          },
          {
            "if": {"properties": {"type": {"const": "true_false_not_given"}}},
            "then": {
              "properties": {
                "answer": {"enum": ["TRUE", "FALSE", "NOT GIVEN"]}
              }
            }
          },
          {
            "if": {"properties": {"type": {"const": "short_answer"}}},
            "then": {
              "anyOf": [
                {"required": ["accepted_answers"]},
                {"required": ["required_answer_groups"]}
              ]
            }
          }
        ]
      }
    }
  }
}
